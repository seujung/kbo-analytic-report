# AI 챗 설정 (Google Gemini API 무료 티어) — 이 파일을 .env 로 복사한 뒤 값을 채우세요 (.env는 git에 커밋되지 않음)
# 무료 API 키 발급: https://aistudio.google.com/apikey
GLM_API_KEY=
# 사용 가능 모델: gemini-3.5-flash-lite, gemini-3.5-flash, gemma-3-27b-it 등 (ai.google.dev/models 참고)
GLM_MODEL=gemini-3.5-flash-lite
GLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
